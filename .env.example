# =============================================================================
# BUILD PATHS (relativos ao diretório deste repositório)
# =============================================================================
API_PATH=../projeto-unifil-general-api
FRONTEND_PATH=../projeto-unifil-fe

# =============================================================================
# CADDY (Reverse Proxy)
# =============================================================================
# Produção: domínio real (ex: projeto.unifil.br)
# Dev: :80 (o docker-compose.dev.yml remapeia para porta 8080 no host)
CADDY_ADDRESS=:80

# =============================================================================
# DATABASE (PostgreSQL)
# =============================================================================
DB_DATABASE=projeto_unifil
DB_USERNAME=laravel
DB_PASSWORD=secret

# =============================================================================
# LARAVEL API
# =============================================================================
APP_NAME=ProjetoUniFil
APP_ENV=local
APP_KEY=base64:GENERATE_WITH_php_artisan_key_generate_--show
APP_DEBUG=true
APP_URL=http://localhost:8080

SESSION_DRIVER=cookie
SESSION_LIFETIME=120
# Dev: localhost | Produção: domínio real
SESSION_DOMAIN=localhost
SESSION_SECURE_COOKIE=false

JWT_SECRET=GENERATE_WITH_php_artisan_jwt_secret_--show
JWT_ALGO=HS256

# Dev: http://localhost:8080 | Produção: URL real do frontend
CORS_ALLOWED_ORIGINS=http://localhost:8080

# =============================================================================
# FRONTEND (React + Vite + TypeScript)
# =============================================================================
# Produção: URL pública da API (ex: https://projeto.unifil.br/api)
# Dev: valor ignorado — docker-compose.dev.yml força http://localhost:8080/api
VITE_API_BASE=http://localhost/api
